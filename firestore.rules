rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function adminRoles() {
      return [
        "admin",
        "Admin",
        "ADMIN",
        "administrator",
        "Administrator",
        "super_admin",
        "superadmin"
      ];
    }

    function adminEmails() {
      return [
        "norahsulialaqeel@gmail.com"
      ];
    }

    function hasAdminMarker(data) {
      return data.role in adminRoles()
        || data.userRole in adminRoles()
        || data.accountType in adminRoles()
        || data.isAdmin == true
        || data.isAdmin == "true"
        || data.admin == true
        || data.admin == "true";
    }

    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.admin == true
          || request.auth.token.isAdmin == true
          || request.auth.token.email in adminEmails()
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && hasAdminMarker(
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data
            )
          )
        );
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && !hasAdminMarker(request.resource.data);
      allow update: if (
          isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'admin',
            'isAdmin',
            'role',
            'userRole',
            'accountType'
          ])
        )
        || (
          isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isBlocked',
            'blockedAt',
            'blockedBy',
            'unblockedAt',
            'unblockedBy',
            'updatedAt'
          ])
        );
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/favorites/{favoriteId} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /users/{uid}/notifications/{notificationId} {
      allow read, create, update, delete: if isOwner(uid);
    }

    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isSignedIn()
        && (
          isAdmin()
          || 
          resource.data.ownerUid == request.auth.uid
          || (
            request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['status', 'updatedAt'])
            && (resource.data.status == null || resource.data.status == 'Active')
            && request.resource.data.status == 'Sold'
          )
        );
      allow delete: if isSignedIn()
        && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /orders/{orderId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    match /drivers/{driverId} {
      allow create: if isSignedIn() && request.auth.uid == driverId;
      allow read: if (isSignedIn() && request.auth.uid == driverId) || isAdmin();
      allow update: if (isSignedIn() && request.auth.uid == driverId) || isAdmin();
      allow delete: if isAdmin();
    }
  }
}
